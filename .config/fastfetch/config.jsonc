{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "green",
      "2": "blue",
      "3": "bright_black",
      "4": "yellow",
      "5": "cyan",
      "6": "white"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " → "
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": "--------------------------------"
    },
    {
      "type": "custom",
      "format": "Hardware Information"
    },
    {
      "type": "disk",
      "key": "/ ",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "memory",
      "key": "󰟖 "
    },
    {
      "type": "display",
      "key": "󰍹 ",
      "format": "{1}x{2} @ {3}Hz [{7}]"
    },
    {
      "type": "battery",
      "key": "󱈑 "
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "format": "{1} ({3}c/{4}t) @ {7}"
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "format": "{2}",
      "hideType": "integrated"
    },
    {
      "type": "custom",
      "format": "--------------------------------"
    },
    {
      "type": "custom",
      "format": "Software Information"
    },
    {
      "type": "os",
      "key": "󰣛 "
    },
    {
      "type": "kernel",
      "key": "󰌽 "
    },
    {
      "type": "shell",
      "key": "󱆃 "
    },
    {
      "type": "wm",
      "key": "󰖲 ",
      "format": "{2} {5} ({3})"
    },
    {
      "type": "uptime",
      "key": "󰥔 "
    },
    {
      "type": "packages",
      "key": "󰏗 ",
      "format": "{rpm} rpm · {flatpak-all} flatpak · {brew-all} brew · {snap} snap"
    },
    {
      "type": "command",
      "key": "󰪠 ",
      "text": "cat \"${XDG_CACHE_HOME:-$HOME/.cache}/pkg-updates\" 2>/dev/null || echo '(sem dados ainda)'"
    },
    {
      "type": "custom",
      "format": "--------------------------------"
    }
  ]
}
