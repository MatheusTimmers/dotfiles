{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/Pictures/unixgirl.jpg",
    "width": 42,
    "height": 21,
    "padding": {
      "top": 0,
      "right": 2
    }
  },
  "display": {
    "separator": " → "
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "custom",
      "format": "--------------------------------"
    },
    {
      "type": "custom",
      "format": "Hardware Information"
    },
    {
      "type": "disk",
      "key": "/ ",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "memory",
      "key": "󰟖 "
    },
    {
      "type": "display",
      "key": "󰍹 ",
      "format": "{1}x{2} @ {3}Hz [{7}]"
    },
    {
      "type": "battery",
      "key": "󱈑 "
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "format": "{1} ({3}c/{4}t) @ {7}"
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "format": "{2}",
      "hideType": "integrated"
    },
    {
      "type": "custom",
      "format": "--------------------------------"
    },
    {
      "type": "custom",
      "format": "Software Information"
    },
    {
      "type": "os",
      "key": "󰣛 "
    },
    {
      "type": "kernel",
      "key": "󰌽 "
    },
    {
      "type": "shell",
      "key": "󱆃 "
    },
    {
      "type": "wm",
      "key": "󰖲 ",
      "format": "{2} {5} ({3})"
    },
    {
      "type": "uptime",
      "key": "󰥔 "
    },
    {
      "type": "packages",
      "key": "󰏗 "
    },
    {
      "type": "custom",
      "format": "--------------------------------"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;249;226;175m󰮯\u001b[0m  \u001b[38;2;245;194;231m󰊠\u001b[0m  \u001b[38;2;166;227;161m󰊠\u001b[0m  \u001b[38;2;148;226;213m󰊠\u001b[0m  \u001b[38;2;137;180;250m󰊠\u001b[0m  \u001b[38;2;243;139;168m󰊠\u001b[0m  \u001b[38;2;203;166;247m󰊠\u001b[0m  \u001b[38;2;186;194;222m󰊠\u001b[0m"
    }
  ]
}
