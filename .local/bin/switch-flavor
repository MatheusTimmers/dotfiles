#!/bin/bash
set -uo pipefail

FLAVOR="${1:-}"
VALID=(frappe macchiato mocha latte)

if [[ -z "$FLAVOR" ]] || [[ ! " ${VALID[*]} " =~ " ${FLAVOR} " ]]; then
    echo "Uso: switch-flavor <${VALID[*]// /|}>"
    [[ -n "$FLAVOR" ]] && echo "Flavor inválido: '$FLAVOR'"
    exit 1
fi

case "$FLAVOR" in
    mocha)     BAT="Catppuccin Mocha"; MAUVE=cba6f7; HERDR=catppuccin ;;
    macchiato) BAT="Catppuccin Macchiato"; MAUVE=c6a0f6; HERDR=catppuccin ;;
    frappe)    BAT="Catppuccin Frappe"; MAUVE=ca9ee6; HERDR=catppuccin ;;
    latte)     BAT="Catppuccin Latte"; MAUVE=8839ef; HERDR=catppuccin-latte ;;
esac

C="$HOME/.config"
declare -A LINKS=(
    ["$C/hypr/themes/${FLAVOR}.conf"]="$C/hypr/theme.conf"
    ["$C/hypr/themes-lock/${FLAVOR}.conf"]="$C/hypr/lock-theme.conf"
    ["$C/kitty/themes/${FLAVOR}.conf"]="$C/kitty/current-theme.conf"
    ["$C/mako/themes/${FLAVOR}"]="$C/mako/theme"
    ["$C/fuzzel/themes/${FLAVOR}.ini"]="$C/fuzzel/theme.ini"
)

for src in "${!LINKS[@]}"; do
    [[ -f "$src" ]] || { echo "Arquivo não encontrado: $src"; exit 1; }
done

echo "Aplicando flavor: $FLAVOR"

for src in "${!LINKS[@]}"; do
    ln -sf "$src" "${LINKS[$src]}"
done

sed -i --follow-symlinks "s/^palette = \"catppuccin_.*\"/palette = \"catppuccin_${FLAVOR}\"/" "$C/starship.toml"
sed -i --follow-symlinks "s/^color_theme = .*/color_theme = \"catppuccin_${FLAVOR}\"/" "$C/btop/btop.conf"
sed -i --follow-symlinks "s/^name = .*/name = \"${HERDR}\"/; s/^accent = .*/accent = \"#${MAUVE}\"/" "$C/herdr/config.toml"
sed -i --follow-symlinks "s/syntax-theme = Catppuccin .*/syntax-theme = ${BAT}/" "$HOME/.gitconfig"
printf '%s\n' "--theme=\"${BAT}\"" > "$C/bat/config"

echo "$FLAVOR" > "$C/nvim/flavor"
echo "$FLAVOR" > "$C/quickshell/flavor"

hyprctl reload >/dev/null
pkill -USR1 kitty 2>/dev/null
pgrep -x mako >/dev/null && makoctl reload
herdr server reload-config >/dev/null 2>&1

for sock in $(find "/run/user/$(id -u)" -name 'nvim*' -type s 2>/dev/null); do
    nvim --server "$sock" --remote-send ":Catppuccin ${FLAVOR}<CR>" 2>/dev/null
done

echo "Pronto!"
